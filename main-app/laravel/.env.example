APP_NAME=Laravel
APP_ENV=local
APP_KEY=

JWT_SECRET=
JWT_TTL=60
APP_DEBUG=true
APP_URL=http://127.0.0.1:8081

STOREFRONT_BRAND="Everyday Tech"
# Optional ISO 4217 code. Leave empty to show decimal amounts without a symbol.
STOREFRONT_CURRENCY=
# Blank uses the Laravel page origin. Set only when the public catalog or images are hosted separately.
STOREFRONT_API_ORIGIN=
STOREFRONT_STORAGE_ORIGIN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
# To enable Reverb, set BROADCAST_CONNECTION=reverb and configure all three app credentials.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Local Reverb defaults to ws://127.0.0.1:8080. Set a public wss:// URL in production.
# STOREFRONT_REVERB_URL=ws://127.0.0.1:8080
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Customer order push. Local notifications are always saved.
ORDER_PUSH_DRIVER=disabled
FIREBASE_PROJECT_ID=
# Absolute path outside the repository/public; mount a read-only Docker secret.
FIREBASE_CREDENTIALS=
ORDER_PUSH_TIMEOUT=10
ORDER_PUSH_CONNECT_TIMEOUT=3
ORDER_PUSH_MAX_ATTEMPTS=5
ORDER_PUSH_BACKOFF=60
ORDER_PUSH_FAKE_RESULTS=accepted

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
