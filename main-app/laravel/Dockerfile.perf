# Performance-only image build for Requirement 3.
# Same base as Dockerfile with bounded retries around PECL downloads.
# Demo Dockerfile remains unchanged.
FROM php:8.3-cli

RUN apt-get update && apt-get install -y \
    git \
    unzip \
    libicu-dev \
    libzip-dev \
    libssl-dev \
    $PHPIZE_DEPS \
    && docker-php-ext-install \
    pdo_mysql \
    bcmath \
    pcntl \
    intl \
    zip \
    && pecl install protobuf \
    && ( \
        pecl install grpc \
        || (sleep 5 && pecl install grpc) \
        || (sleep 15 && pecl install grpc) \
      ) \
    && docker-php-ext-enable protobuf grpc \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

COPY docker/php/uploads.ini ${PHP_INI_DIR}/conf.d/zz-uploads.ini

COPY . .

RUN composer install --no-interaction --prefer-dist

EXPOSE 8000

CMD ["sh", "-c", "(test -d public/storage || php artisan storage:link --relative) && test -d public/storage && exec php artisan serve --no-reload --host=0.0.0.0 --port=8000"]
