# Mounted into the perf app container as /var/www/.env (read-only).
# Never copy these values into the demo .env.
APP_NAME="Ecommerce Perf"
APP_ENV=performance
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ecommerce_main_perf
DB_USERNAME=ecommerce_perf_user
DB_PASSWORD=ecommerce_perf_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Catalog cache + ETag (stock never stored in Redis).
PERF_CATALOG_CACHE=1
PERF_PRODUCT_ETAG=1
PERF_ORDERS_USE_PRIMARY=1

# Read replica host (set to mysql-replica after Initialize-MysqlReplica.ps1).
DB_READ_HOST=mysql-replica

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="perf@example.test"
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=
JWT_TTL=60

INVENTORY_GRPC_HOST=inventory-service:9090
INVENTORY_GRPC_TIMEOUT=3000000

PERF_ENVIRONMENT=1
PERF_COMPOSE_PROJECT=ecommerce2026-perf
PERF_HTTP_BASE=http://127.0.0.1:8010
PERF_GRPC_HOST_PORT=127.0.0.1:9100
